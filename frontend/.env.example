# Point this at your FastAPI backend once it's running.
# e.g. http://localhost:8000 or your deployed API URL.
VITE_API_BASE_URL=http://localhost:8000

# Public origin of the deployed site, no trailing slash (e.g. https://careerprepai.example).
# Used at BUILD time for canonical URLs, Open Graph URLs/images and sitemap.xml. Leave empty until you have a domain.
VITE_SITE_URL=

# Shown on the Privacy and Terms pages. Leave empty until you have a real contact address.
VITE_CONTACT_EMAIL=

# Set to true once the Privacy Policy and Terms have been reviewed and completed by the site owner;
# it removes the "draft" notice from those pages.
VITE_LEGAL_REVIEWED=false
