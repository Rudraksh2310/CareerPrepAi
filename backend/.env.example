# PostgreSQL connection — update with your actual credentials.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/careerprepai

# "development" (default) or "production". In production the app refuses to start with a default/short SECRET_KEY.
ENVIRONMENT=development

# Used to sign JWTs. Generate your own, e.g. `openssl rand -hex 32`.
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call this API (your frontend dev URL).
CORS_ORIGINS=http://localhost:5173

# ---- LLM (resume extraction, follow-up questions, feedback report) ----
# "claude", "openai" or "groq". Only the matching key below is needed.
# With no key the app still runs on a built-in offline engine (no real AI follow-ups); the lobby and the call
# header show a warning when that happens. LLM_PROVIDER must match the key you filled in.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
GROQ_MODEL=openai/gpt-oss-120b

# ---- RAG ----
# auto = ChromaDB if it works (first run downloads a ~80MB embedding model), else built-in TF-IDF.
RAG_BACKEND=auto
RAG_PERSIST_DIR=./.chroma

# ---- Voice ----
# Speech-to-text fallback for browsers without built-in recognition (Firefox/Safari): groq | openai | none
# (Chrome/Edge use their built-in recogniser and need no key.)
STT_PROVIDER=groq
# Interviewer voice: edge (free, no key) | openai | elevenlabs | browser (device voice, no server audio)
TTS_PROVIDER=edge
# Voice of the default interviewer (Aria). The other characters (Arjun, Meera, Daniel, Marcus) have their own fixed voices
# defined in backend/app/core/personas.py; if one of those voices is unavailable the server falls back to this one.
TTS_VOICE_EDGE=en-US-AriaNeural
TTS_VOICE_OPENAI=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Interview ----
# Round 1 (technical): total questions and how many topics they are spread over.
TECHNICAL_QUESTIONS=10
TECHNICAL_TOPICS=5
# Round 2 (resume): the EXACT number of questions. Items are covered in order (experience, projects, education, ...);
# a resume with more items than this is not covered completely, one with fewer gets follow-ups. Never more than the topics can yield.
RESUME_MAX_QUESTIONS=5
MAX_FOLLOWUPS_PER_TOPIC=3

# ---- Hardening ----
# Resume upload cap in bytes (enforced while the body is read) and the cap for every other JSON request body.
MAX_UPLOAD_BYTES=5242880
MAX_JSON_BODY_BYTES=262144
# In-memory, per-process rate limits on register/login/upload/voice. For several workers/instances, also limit at the proxy.
RATE_LIMIT_ENABLED=true
# Set true ONLY behind a reverse proxy you control; then X-Forwarded-For is used as the client IP.
TRUST_PROXY=false
